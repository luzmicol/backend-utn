# ============================================
# LOOP Backend - Variables de entorno ejemplo
# Copiar a .env y completar con valores reales
# ============================================

# --- Servidor ---
# Opcional: puerto local de Express (por defecto 8080)
PORT=8080
# Opcional: entorno de ejecucion (development | production)
NODE_ENV=development

# --- Base de datos MongoDB (Obligatorias) ---
# URI de conexion a MongoDB Atlas o instancia local
MONGO_DB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Nombre de la base de datos
MONGO_DB_NAME=loop_db

# --- Autenticacion JWT (Obligatoria) ---
# Clave secreta larga y aleatoria para firmar tokens JWT
JWT_SECRET_KEY=reemplazar_por_un_secreto_largo_y_seguro

# --- Correo electronico / Nodemailer Gmail (Obligatorias para verificacion y recuperacion) ---
GMAIL_USER=tu_correo@gmail.com
# Contraseña de aplicacion (App Password) de Gmail
GMAIL_PASSWORD=xxxx_xxxx_xxxx_xxxx

# --- URLs y CORS ---
# Obligatoria: una UNICA URL base del frontend (sin comas ni barra final) para enlaces de email
URL_FRONTEND=http://localhost:5173
# Opcional: origenes adicionales permitidos por CORS separados por coma
CORS_ORIGINS=
# Opcional: URL publica del backend (documentacion Swagger)
URL_BACKEND=http://localhost:8080

# --- Almacenamiento de imagenes (Obligatoria para subir avatares e imagenes de posts) ---
# Token de lectura/escritura de Vercel Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_placeholder

# --- Control de acceso por IP (Opcionales) ---
# Opcional: lista de IPs bloqueadas globalmente separadas por coma (vacio = desactivado)
IP_BLACKLIST=
# Opcional: lista de IPs permitidas para rutas restringidas como /api/docs (vacio = desactivado)
IP_WHITELIST=

# --- Integracion externa por API Key ---
# Requerida para habilitar el endpoint tecnico GET /api/system/status (header x-api-key)
API_KEY=reemplazar_por_api_key_segura
